---
// Hand-drawn accent asterisk that slowly turns and pulses — the ambient
// mark of the motion language (styles/motion.css .kicker-spark). Place it
// before an eyebrow or a section heading.
---

<span class='kicker-spark' aria-hidden='true'>
	<svg
		viewBox='0 0 16 16'
		fill='none'
		stroke='currentColor'
		stroke-width='1.6'
		stroke-linecap='round'
	>
		<path
			d='M8 1.5 Q8.3 8 8 14.5 M1.5 8 Q8 7.7 14.5 8 M3.8 3.8 Q8 8 12.2 12.2 M12.2 3.8 Q8 8 3.8 12.2'
		></path>
	</svg>
</span>
