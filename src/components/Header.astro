---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
	{ href: '/', text: 'Home' },
	{ href: '/projects', text: 'Work' },
	{ href: '/experience', text: 'Experience' },
	{ href: '/activities', text: 'Activities' },
	{ href: '/blog', text: 'Writing' },
	{ href: '/contact', text: 'Contact' },
];
---

<header id='site-header' class='fixed top-0 left-0 right-0 z-[var(--z-header)]'>
	<nav class='max-w-7xl mx-auto px-6 py-4'>
		<div
			class='backdrop-blur-lg bg-surface/90 border border-border/70 rounded-2xl px-5 py-3 flex items-center justify-between shadow-[var(--shadow-soft)]'
		>
			<a
				href='/'
				class='text-lg md:text-xl font-semibold font-display tracking-tight'
			>
				Dhruv Verma
			</a>

			<div class='hidden md:flex items-center gap-7'>
				{
					navItems.map((item) => (
						<a
							href={item.href}
							class='nav-link ink-link text-sm font-medium text-muted hover:text-ink transition-colors relative'
						>
							{item.text}
						</a>
					))
				}
				<ThemeToggle />
			</div>

			<button
				id='mobile-menu-toggle'
				class='md:hidden inline-flex items-center justify-center rounded-md border border-border/70 px-3 py-2 text-sm text-ink'
				aria-label='Toggle menu'
				aria-expanded='false'
				aria-controls='mobile-menu'
			>
				Menu
			</button>
		</div>
		<div
			id='mobile-menu'
			class='md:hidden mt-3 bg-surface/95 border border-border/70 rounded-2xl p-4 shadow-[var(--shadow-soft)] hidden'
		>
			<div class='flex flex-col gap-3'>
				{
					navItems.map((item) => (
						<a
							href={item.href}
							class='text-sm font-medium text-muted hover:text-ink'
						>
							{item.text}
						</a>
					))
				}
				<div class='pt-2 border-t border-border/70'>
					<ThemeToggle />
				</div>
			</div>
		</div>
	</nav>
</header>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	gsap.registerPlugin(ScrollTrigger);

	// On-demand nav: the header steps aside while reading (scroll down) and
	// returns on any upward scroll, at the top of the page, on keyboard focus,
	// or while the mobile menu is open. Rides the site's global ScrollTrigger.
	document.addEventListener('DOMContentLoaded', () => {
		const header = document.getElementById('site-header');
		const menuEl = document.getElementById('mobile-menu');
		if (header) {
			const show = () => header.classList.remove('header-hidden');
			const hide = () => header.classList.add('header-hidden');
			ScrollTrigger.create({
				start: 0,
				end: 'max',
				onUpdate(self) {
					const menuOpen = menuEl && !menuEl.classList.contains('hidden');
					if (self.scroll() < 96 || self.direction < 0) {
						show();
					} else if (
						self.direction > 0 &&
						!menuOpen &&
						!header.matches(':focus-within')
					) {
						hide();
					}
				},
			});
			header.addEventListener('focusin', show);
		}
	});

	document.addEventListener('DOMContentLoaded', () => {
		const toggle = document.getElementById('mobile-menu-toggle');
		const menu = document.getElementById('mobile-menu');
		if (!toggle || !menu) return;

		const focusables = (): HTMLElement[] =>
			Array.from(menu.querySelectorAll<HTMLElement>('a[href], button, [tabindex]:not([tabindex="-1"])'));
		const firstFocusable = () => focusables()[0];
		const lastFocusable = () => focusables()[focusables().length - 1];

		const setOpen = (isOpen: boolean) => {
			toggle.setAttribute('aria-expanded', String(isOpen));
			menu.classList.toggle('hidden', !isOpen);
			if (isOpen) {
				firstFocusable()?.focus();
			} else {
				toggle.focus();
			}
		};

		setOpen(false);

		toggle.addEventListener('click', () => {
			const isOpen = toggle.getAttribute('aria-expanded') === 'true';
			setOpen(!isOpen);
		});

		menu.addEventListener('keydown', (e: KeyboardEvent) => {
			if (e.key !== 'Tab') return;
			const els = focusables();
			if (els.length === 0) return;
			const first = els[0];
			const last = els[els.length - 1];
			if (e.shiftKey) {
				if (document.activeElement === first) {
					e.preventDefault();
					last?.focus();
				}
			} else {
				if (document.activeElement === last) {
					e.preventDefault();
					first?.focus();
				}
			}
		});

		document.addEventListener('keydown', (e: KeyboardEvent) => {
			if (e.key !== 'Escape') return;
			const isOpen = toggle.getAttribute('aria-expanded') === 'true';
			if (isOpen) setOpen(false);
		});

		menu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});
	});
</script>

<style>
	header {
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}
	:global(#site-header.header-hidden) {
		transform: translateY(calc(-100% - 8px));
	}
	@media (prefers-reduced-motion: reduce) {
		header {
			transition: none;
		}
	}
	/* underline comes from the shared .ink-link (styles/motion.css) */
	.nav-link {
		display: inline-block;
	}
</style>
