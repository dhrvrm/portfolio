---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CursorFollower from '../components/CursorFollower.astro';
import TransitionOverlay from '../components/TransitionOverlay.astro';
import KeyboardShortcuts from '../components/KeyboardShortcuts.astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/base.css';
import '../styles/tokens.css';
import '../styles/motion.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
	imageWidth?: number;
	imageHeight?: number;
	article?: boolean;
	prevHref?: string;
	nextHref?: string;
}

const {
	title,
	description = 'Product engineer building reliable products, mentoring builders, and learning through travel and collaboration.',
	image = '/og-image.png',
	imageWidth,
	imageHeight,
	article = false,
	prevHref,
	nextHref,
} = Astro.props;

const canonicalURL = new URL(
	Astro.url.pathname,
	Astro.site || 'https://dhruvverma.dev',
).toString();
---

<!doctype html>
<html lang='en' class='scroll-smooth'>
	<head>
		<meta charset='UTF-8' />
		<meta name='description' content={description} />
		<meta name='viewport' content='width=device-width' />
		<script is:inline>
			(() => {
				try {
					const stored = localStorage.getItem('theme');
					const prefersDark = window.matchMedia(
						'(prefers-color-scheme: dark)',
					).matches;
					const theme = stored || (prefersDark ? 'dark' : 'light');
					if (theme === 'dark') {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
				} catch (error) {
					console.warn('Theme init failed', error);
				}
			})();
		</script>

		<link rel='icon' type='image/png' href='/favicon-96x96.png' sizes='96x96' />
		<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
		<link rel='shortcut icon' href='/favicon.ico' />
		<link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png' />
		<meta name='apple-mobile-web-app-title' content='Dhruv' />
		<link rel='manifest' href='/site.webmanifest' />

		<meta name='generator' content={Astro.generator} />
		<link rel='canonical' href={canonicalURL} />
		{prevHref && (
			<link rel='prev' href={new URL(prevHref, Astro.site).toString()} />
		)}
		{nextHref && (
			<link rel='next' href={new URL(nextHref, Astro.site).toString()} />
		)}
		<title>{title}</title>
		<style is:global>
			/* Critical: overlay covers from first paint so no flash before entrance */
			#page-transition {
				position: fixed;
				inset: 0;
				z-index: var(--z-overlay);
				overflow: hidden;
				pointer-events: none;
			}
			#page-transition .pt__panel {
				position: absolute;
				top: 0;
				bottom: 0;
				width: 50vw;
				background: rgb(var(--color-surface));
			}
			#page-transition .pt__panel--left {
				left: 0;
				transform: translateX(0);
			}
			#page-transition .pt__panel--right {
				right: 0;
				transform: translateX(0);
			}
			#page-transition .pt__circle {
				position: absolute;
				left: 50%;
				top: 50%;
				width: 8rem;
				height: 8rem;
				margin: -4rem 0 0 -4rem;
				border-radius: 50%;
				background: rgb(var(--color-accent) / 0.25);
				filter: blur(40px);
				transform: scale(8);
				opacity: 0.9;
			}
		</style>
		<style is:global>
			html {
				scroll-padding-top: 100px;
			}

			/* Custom Scrollbar - Global */
			::-webkit-scrollbar {
				width: 10px;
				height: 10px;
			}

			::-webkit-scrollbar-track {
				background: transparent;
			}

			/* Theme-aware scrollbar: muted token swaps per theme automatically */
			::-webkit-scrollbar-thumb {
				background-color: rgb(var(--color-muted) / 0.4);
				border-radius: 9999px;
				border: 2px solid transparent;
				background-clip: content-box;
			}

			::-webkit-scrollbar-thumb:hover {
				background-color: rgb(var(--color-muted) / 0.6);
			}

			/* For Firefox */
			* {
				scrollbar-width: thin;
				scrollbar-color: rgb(var(--color-muted) / 0.4) transparent;
			}
		</style>
		<script>
			// Enhanced clipboard functionality for all code blocks
			function addClipboardToCodeBlocks() {
				// Target both pre tags and code blocks with specific classes
				const codeBlocks = document.querySelectorAll(
					'pre, .astro-code, .shiki, [class*="language-"]',
				);

				codeBlocks.forEach((block) => {
					// Skip if already has clipboard button
					if (block.querySelector('.clipboard-button')) return;

					const wrapper = document.createElement('div');
					wrapper.className = 'relative group';

					const button = document.createElement('button');
					button.className =
						'clipboard-button absolute top-2 right-2 p-2 rounded-md bg-gray-800/60 opacity-0 group-hover:opacity-100 transition-opacity text-gray-300 hover:text-white z-[var(--z-raised)]';
					button.setAttribute('aria-label', 'Copy code to clipboard');
					button.innerHTML = `
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
							<path d="M8 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z" />
							<path d="M6 3a2 2 0 00-2 2v11a2 2 0 002 2h8a2 2 0 002-2V5a2 2 0 00-2-2 3 3 0 01-3 3H9a3 3 0 01-3-3z" />
						</svg>
					`;

					button.addEventListener('click', async (e) => {
						e.preventDefault();
						e.stopPropagation();

						try {
							// Get the text content, handling different code block structures
							let textToCopy = '';
							const codeElement = block.querySelector('code');

							if (codeElement) {
								textToCopy = codeElement.textContent || '';
							} else {
								textToCopy = block.textContent || '';
							}

							await navigator.clipboard.writeText(textToCopy);

							// Show success state
							button.innerHTML = `
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
									<path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" />
									<path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm9.707 5.707a1 1 0 00-1.414-1.414L9 12.586l-1.293-1.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
								</svg>
							`;

							// Reset after 2 seconds
							setTimeout(() => {
								button.innerHTML = `
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
										<path d="M8 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z" />
										<path d="M6 3a2 2 0 00-2 2v11a2 2 0 002 2h8a2 2 0 002-2V5a2 2 0 00-2-2 3 3 0 01-3 3H9a3 3 0 01-3-3z" />
									</svg>
								`;
							}, 2000);
						} catch (err) {
							console.error('Failed to copy code:', err);
							// Fallback for older browsers
							const textArea = document.createElement('textarea');
							textArea.value = block.textContent || '';
							document.body.appendChild(textArea);
							textArea.select();
							document.execCommand('copy');
							document.body.removeChild(textArea);
						}
					});

					// Insert wrapper and move block into it
					if (block.parentNode) {
						block.parentNode.insertBefore(wrapper, block);
						wrapper.appendChild(block);
						wrapper.appendChild(button);
					}
				});
			}

			document.addEventListener('DOMContentLoaded', addClipboardToCodeBlocks);
		</script>
		<!-- Primary Meta Tags -->
		<meta name='title' content={title} />

		<!-- Open Graph / Facebook -->
		<meta property='og:type' content={article ? 'article' : 'website'} />
		<meta property='og:url' content={canonicalURL} />
		<meta property='og:title' content={title} />
		<meta property='og:description' content={description} />
		<meta property='og:image' content={new URL(image, Astro.site)} />
		{(imageWidth != null || image === '/og-image.png') && (
			<meta
				property='og:image:width'
				content={String(imageWidth ?? 1200)}
			/>
		)}
		{(imageHeight != null || image === '/og-image.png') && (
			<meta
				property='og:image:height'
				content={String(imageHeight ?? 630)}
			/>
		)}

		<!-- Twitter -->
		<meta property='twitter:card' content='summary_large_image' />
		<meta property='twitter:site' content='@verma1300' />
		<meta property='twitter:creator' content='@verma1300' />
		<meta property='twitter:url' content={canonicalURL} />
		<meta property='twitter:title' content={title} />
		<meta property='twitter:description' content={description} />
		<meta property='twitter:image' content={new URL(image, Astro.site)} />

		<!-- Google tag (gtag.js) -->
		<script
			type='text/partytown'
			async
			src='https://www.googletagmanager.com/gtag/js?id=G-3VCWW3H8PM'></script>
		<script type='text/partytown'>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());

			gtag('config', 'G-3VCWW3H8PM');
		</script>
	</head>
	<body class='min-h-screen font-sans antialiased'>
		<script>
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';
			gsap.registerPlugin(ScrollTrigger);
			window.gsap = gsap;
			window.ScrollTrigger = ScrollTrigger;

			// Inline blog doodles (svg.blog-doodle) sketch themselves on scroll.
			// Sequencing model: one [data-step] group = one semantic gesture — its
			// paths draw together with a tight stagger (Gestalt common fate); steps
			// run sequentially in DOM order (reading order, cause before effect);
			// [data-beat] pauses before a step (timing beat before the payoff);
			// circles/text fade in last (closure). Reduced motion skips it all.
			const doodles = document.querySelectorAll('svg.blog-doodle');
			const reducedMotion = window.matchMedia(
				'(prefers-reduced-motion: reduce)'
			).matches;
			if (!reducedMotion) {
				doodles.forEach((svg) => {
					const strokes = Array.from(svg.querySelectorAll('path'));
					const reveals = Array.from(svg.querySelectorAll('circle, text'));
					// Paths with an authored stroke-dasharray (dotted/dashed marks)
					// can't use the dash-draw trick without losing their pattern —
					// they fade in with their step instead.
					const isDashed = (p) => p.hasAttribute('stroke-dasharray');
					strokes.forEach((p) => {
						if (isDashed(p)) return;
						const len = p.getTotalLength();
						p.style.strokeDasharray = `${len}`;
						p.style.strokeDashoffset = `${len}`;
					});
					gsap.set(strokes.filter(isDashed), { opacity: 0 });
					gsap.set(reveals, { opacity: 0 });
					const steps = [];
					strokes.forEach((p) => {
						const group = p.closest('[data-step]');
						const last = steps[steps.length - 1];
						if (group && last && last.key === group) {
							last.paths.push(p);
						} else {
							steps.push({ key: group || p, el: group || p, paths: [p] });
						}
					});
					const tl = gsap.timeline({
						scrollTrigger: { trigger: svg, start: 'top 85%', once: true },
					});
					steps.forEach((step) => {
						const beat = parseFloat(step.el.dataset?.beat || '') || 0;
						const pos = beat ? `>+${beat}` : '>-0.05';
						const solid = step.paths.filter((p) => !isDashed(p));
						const dashed = step.paths.filter(isDashed);
						if (solid.length) {
							tl.to(
								solid,
								{
									strokeDashoffset: 0,
									duration: (i, target) =>
										gsap.utils.clamp(0.15, 0.7, target.getTotalLength() / 500),
									ease: 'power1.inOut',
									stagger: 0.05,
								},
								pos
							);
						}
						if (dashed.length) {
							tl.to(
								dashed,
								{ opacity: 1, duration: 0.45, ease: 'power1.out', stagger: 0.08 },
								solid.length ? '<+0.1' : pos
							);
						}
					});
					tl.to(reveals, { opacity: 1, duration: 0.35, stagger: 0.04 }, '>-0.1');
				});
			}
		</script>
		<!-- First-Tab panel: skip link + shortcut primer for keyboard visitors.
		     Pure CSS (:focus-within) so it works before any JS runs. -->
		<div class='skip-panel'>
			<p class='skip-panel-label' aria-hidden='true'>skip to</p>
			<a href='#main-content' class='skip-link'>Main content</a>
			<div class='skip-hints' aria-hidden='true'>
				<p class='skip-panel-label'>keyboard shortcuts</p>
				<ul class='skip-hint-rows'>
					<li><span>all shortcuts</span><kbd>?</kbd></li>
					<li><span>go home / writing</span><span><kbd>g</kbd> <kbd>h</kbd> · <kbd>g</kbd> <kbd>b</kbd></span></li>
					<li><span>scroll</span><span><kbd>j</kbd> / <kbd>k</kbd></span></li>
					<li><span>theme</span><kbd>t</kbd></li>
				</ul>
			</div>
			<button type='button' class='skip-more' data-shortcuts-trigger>
				View all shortcuts
			</button>
		</div>
		<div
			class="fixed inset-0 bg-[url('/noise.png')] opacity-[0.02] pointer-events-none"
		>
		</div>
		<CursorFollower />
		<TransitionOverlay />
		<KeyboardShortcuts />
		<div class='max-w-7xl mx-auto px-6'>
			<Header />
			<main id='main-content' class='min-h-screen pt-24'>
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>
